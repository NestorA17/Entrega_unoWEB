@page "/tipoproducto"
@inject FrontBlazor_AppiGenericaCsharp.Services.AuthService Auth
@inject NavigationManager Nav
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Gestión de Tipos de Producto</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
        --morado: #8B5CF6;
        --morado-oscuro: #7C3AED;
        --fondo: #F7F4FA;
        --blanco: #ffffff;
        --texto: #1e1535;
        --texto-suave: #7c6fa3;
        --borde: #ddd4e6;
        --rojo: #e05252;
    }

    .tipoproducto-wrapper { font-family: 'DM Sans', sans-serif; background-color: var(--fondo); min-height: 100vh; padding: 2rem; color: var(--texto); }

    .tipoproducto-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 2px solid var(--borde); }
    .tipoproducto-header h1 { font-family: 'Syne', sans-serif; font-size: 2.2rem; font-weight: 800; color: var(--texto); margin: 0; line-height: 1; }
    .tipoproducto-header h1 span { color: var(--morado); }
    .tipoproducto-header p { margin: 0.3rem 0 0; font-size: 0.9rem; color: var(--texto-suave); font-weight: 300; }

    .btn-nuevo { background-color: var(--morado); color: white; border: none; padding: 0.65rem 1.4rem; border-radius: 10px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: background 0.2s, transform 0.1s; }
    .btn-nuevo:hover { background-color: var(--morado-oscuro); transform: translateY(-1px); }

    .alerta { padding: 0.9rem 1.2rem; border-radius: 10px; margin-bottom: 1.5rem; font-size: 0.9rem; font-weight: 500; }
    .alerta.exito { background: #e6f9ee; color: #15803d; border: 1px solid #bbf7d0; }
    .alerta.error { background: #fdeaea; color: #b83232; border: 1px solid #f5c0c0; }

    .tabla-card { background: var(--blanco); border-radius: 16px; border: 1px solid var(--borde); overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.04); }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    thead { background-color: var(--texto); color: white; }
    thead th { padding: 1rem 1.2rem; text-align: left; font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase; }
    tbody tr { border-bottom: 1px solid var(--borde); transition: background 0.15s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background-color: #f5f0ff; }
    tbody td { padding: 0.9rem 1.2rem; color: var(--texto); vertical-align: middle; }

    .id-badge { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.82rem; background: #ede9fe; color: var(--morado-oscuro); padding: 0.2rem 0.6rem; border-radius: 6px; display: inline-block; }
    .categoria-badge { background: #f5f0ff; color: var(--morado-oscuro); border: 1px solid #ddd4f5; padding: 0.15rem 0.6rem; border-radius: 20px; font-size: 0.78rem; font-weight: 500; }
    .clase-badge { background: #fdf4ff; color: #9333ea; border: 1px solid #e9d5ff; padding: 0.15rem 0.6rem; border-radius: 20px; font-size: 0.78rem; font-weight: 500; }

    .acciones { display: flex; gap: 0.5rem; }
    .btn-editar { background: #fff8e1; color: #b8860b; border: 1px solid #f5c842; padding: 0.35rem 0.8rem; border-radius: 7px; font-size: 0.8rem; font-weight: 500; cursor: pointer; }
    .btn-editar:hover { background: #fff3c0; }
    .btn-eliminar { background: #fdeaea; color: var(--rojo); border: 1px solid #f5c0c0; padding: 0.35rem 0.8rem; border-radius: 7px; font-size: 0.8rem; font-weight: 500; cursor: pointer; }
    .btn-eliminar:hover { background: #fbd5d5; }

    .sin-datos { text-align: center; padding: 3rem; color: var(--texto-suave); font-size: 0.95rem; }
    .cargando { text-align: center; padding: 3rem; color: var(--texto-suave); }

    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.35); display: flex; align-items: center; justify-content: center; z-index: 1000; }

    .modal { background: var(--blanco) !important; border-radius: 18px !important; padding: 2rem !important; width: 100% !important; max-width: 540px !important; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.15) !important; animation: slideUp 0.25s ease; display: block !important; visibility: visible !important; z-index: 1001 !important; position: relative !important; }

    @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .modal h2 { font-family: 'Syne', sans-serif; font-size: 1.4rem; font-weight: 800; margin: 0 0 1.5rem; color: var(--texto); }
    .modal h2 span { color: var(--morado); }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
    .campo-full { grid-column: 1 / -1; }

    .campo { margin-bottom: 1.1rem !important; display: block !important; }
    .campo label { display: block !important; font-size: 0.8rem !important; font-weight: 500 !important; color: var(--texto-suave) !important; margin-bottom: 0.4rem !important; text-transform: uppercase !important; letter-spacing: 0.04em !important; }
    .campo input, .campo select { width: 100% !important; padding: 0.65rem 0.9rem !important; border: 1.5px solid var(--borde) !important; border-radius: 9px !important; font-family: 'DM Sans', sans-serif !important; font-size: 0.9rem !important; color: var(--texto) !important; background: var(--fondo) !important; box-sizing: border-box !important; display: block !important; visibility: visible !important; opacity: 1 !important; height: auto !important; min-height: 40px !important; }
    .campo input:focus, .campo select:focus { outline: none !important; border-color: var(--morado) !important; background: white !important; }
    .campo input:disabled { opacity: 0.6 !important; cursor: not-allowed !important; }

    .modal-acciones { display: flex; gap: 0.8rem; margin-top: 1.5rem; justify-content: flex-end; }
    .btn-guardar { background: var(--morado); color: white; border: none; padding: 0.65rem 1.5rem; border-radius: 9px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; }
    .btn-guardar:hover { background: var(--morado-oscuro); }
    .btn-guardar:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-cancelar { background: transparent; color: var(--texto-suave); border: 1.5px solid var(--borde); padding: 0.65rem 1.2rem; border-radius: 9px; font-size: 0.9rem; cursor: pointer; }
    .btn-cancelar:hover { border-color: var(--texto-suave); }

    .modal-confirmar p { color: var(--texto-suave); font-size: 0.93rem; margin: 0.5rem 0 1.5rem; }
    .modal-confirmar strong { color: var(--texto); }
    .btn-confirmar-eliminar { background: var(--rojo); color: white; border: none; padding: 0.65rem 1.5rem; border-radius: 9px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; }
    .btn-confirmar-eliminar:hover { background: #c94040; }
</style>

<div class="tipoproducto-wrapper">

    <div class="tipoproducto-header">
        <div>
            <h1>Tipos de <span>Producto</span></h1>
            <p>Clasificación de los tipos de productos de investigación</p>
        </div>
        <button class="btn-nuevo" @onclick="AbrirModalNuevo">＋ Nuevo Tipo</button>
    </div>

    @if (!string.IsNullOrEmpty(mensajeAlerta))
    {
        <div class="alerta @(esExito ? "exito" : "error")">
            @(esExito ? "✓" : "✕") @mensajeAlerta
        </div>
    }

    <div class="tabla-card">
        @if (cargando)
        {
            <div class="cargando">Cargando tipos de producto...</div>
        }
        else if (tipos.Count == 0)
        {
            <div class="sin-datos">No hay tipos de producto registrados aún.</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Categoría</th>
                        <th>Clase</th>
                        <th>Nombre</th>
                        <th>Tipología</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tipo in tipos)
                    {
                        <tr>
                            <td><span class="id-badge">@Valor(tipo, "id")</span></td>
                            <td><span class="categoria-badge">@Valor(tipo, "categoria")</span></td>
                            <td><span class="clase-badge">@Valor(tipo, "clase")</span></td>
                            <td>@Valor(tipo, "nombre")</td>
                            <td>@Valor(tipo, "tipologia")</td>
                            <td>
                                <div class="acciones">
                                    <button class="btn-editar" @onclick="() => AbrirModalEditar(tipo)">✎ Editar</button>
                                    <button class="btn-eliminar" @onclick="() => AbrirModalEliminar(tipo)">✕ Eliminar</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (mostrarModal)
    {
        <div class="modal-overlay">
            <div class="modal">
                <h2>@(esEdicion ? "Editar" : "Nuevo") <span>Tipo de Producto</span></h2>
                <div class="form-grid">

                    <div class="campo campo-full">
                        <label>ID *</label>
                        <input type="number" @bind="form_id" placeholder="Ej: 1" disabled="@esEdicion" />
                    </div>

                    <div class="campo">
                        <label>Categoría *</label>
                        <select @bind="form_categoria">
                            <option value="">-- Seleccionar --</option>
                            <option value="Nuevo conocimiento">Nuevo conocimiento</option>
                            <option value="Desarrollo tecnologico">Desarrollo tecnológico</option>
                            <option value="Apropiacion social">Apropiación social</option>
                            <option value="Formacion">Formación</option>
                        </select>
                    </div>

                    <div class="campo">
                        <label>Clase *</label>
                        <input type="text" @bind="form_clase" placeholder="Ej: Artículo" />
                    </div>

                    <div class="campo campo-full">
                        <label>Nombre *</label>
                        <input type="text" @bind="form_nombre" placeholder="Nombre del tipo de producto" />
                    </div>

                    <div class="campo campo-full">
                        <label>Tipología *</label>
                        <input type="text" @bind="form_tipologia" placeholder="Ej: A1, A2, B..." />
                    </div>

                </div>
                <div class="modal-acciones">
                    <button class="btn-cancelar" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn-guardar" @onclick="Guardar" disabled="@guardando">
                        @(guardando ? "Guardando..." : (esEdicion ? "Actualizar" : "Crear"))
                    </button>
                </div>
            </div>
        </div>
    }

    @if (mostrarModalEliminar)
    {
        <div class="modal-overlay">
            <div class="modal modal-confirmar">
                <h2>Eliminar <span>Tipo de Producto</span></h2>
                <p>¿Estás seguro de eliminar <strong>@nombreEliminar</strong>? Esta acción no se puede deshacer.</p>
                <div class="modal-acciones">
                    <button class="btn-cancelar" @onclick="() => mostrarModalEliminar = false">Cancelar</button>
                    <button class="btn-confirmar-eliminar" @onclick="Eliminar" disabled="@guardando">
                        @(guardando ? "Eliminando..." : "Sí, eliminar")
                    </button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private List<Dictionary<string, object?>> tipos = new();
    private bool cargando = true;
    private bool mostrarModal = false;
    private bool mostrarModalEliminar = false;
    private bool esEdicion = false;
    private bool guardando = false;
    private string mensajeAlerta = "";
    private bool esExito = true;

    // Campos del formulario
    private string form_id = "";
    private string form_categoria = "";
    private string form_clase = "";
    private string form_nombre = "";
    private string form_tipologia = "";

    // Para eliminar
    private string idEliminar = "";
    private string nombreEliminar = "";

    // ✅ CORRECTO
protected override async Task OnInitializedAsync()
{
    if (!Auth.EstaAutenticado || !Auth.TieneAcceso("/tipoproducto"))
    {
        Nav.NavigateTo("/login", forceLoad: true);
        return;
    }
    await CargarTipos();
}
    

    private async Task CargarTipos()
    {
        cargando = true;
        tipos = await Api.ListarAsync("tipo_producto");
        cargando = false;
    }

    private string Valor(Dictionary<string, object?> fila, string clave)
        => fila.TryGetValue(clave, out var val) ? val?.ToString() ?? "" : "";

    private void MostrarAlerta(bool exito, string mensaje)
    {
        esExito = exito;
        mensajeAlerta = mensaje;
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            mensajeAlerta = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private void AbrirModalNuevo()
    {
        esEdicion = false;
        form_id = "";
        form_categoria = "";
        form_clase = "";
        form_nombre = "";
        form_tipologia = "";
        mostrarModal = true;
    }

    private void AbrirModalEditar(Dictionary<string, object?> tipo)
    {
        esEdicion = true;
        form_id        = Valor(tipo, "id");
        form_categoria = Valor(tipo, "categoria");
        form_clase     = Valor(tipo, "clase");
        form_nombre    = Valor(tipo, "nombre");
        form_tipologia = Valor(tipo, "tipologia");
        mostrarModal = true;
    }

    private void AbrirModalEliminar(Dictionary<string, object?> tipo)
    {
        idEliminar     = Valor(tipo, "id");
        nombreEliminar = Valor(tipo, "nombre");
        mostrarModalEliminar = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(form_id) ||
            string.IsNullOrWhiteSpace(form_categoria) ||
            string.IsNullOrWhiteSpace(form_clase) ||
            string.IsNullOrWhiteSpace(form_nombre) ||
            string.IsNullOrWhiteSpace(form_tipologia))
        {
            MostrarAlerta(false, "Todos los campos son obligatorios.");
            return;
        }

        guardando = true;

        var datos = new Dictionary<string, object?>
        {
            ["id"]        = int.Parse(form_id),
            ["categoria"] = form_categoria,
            ["clase"]     = form_clase,
            ["nombre"]    = form_nombre,
            ["tipologia"] = form_tipologia
        };

        (bool exito, string mensaje) resultado;

        if (esEdicion)
            resultado = await Api.ActualizarAsync("tipo_producto", "id", form_id, datos);
        else
            resultado = await Api.CrearAsync("tipo_producto", datos);

        guardando = false;
        mostrarModal = false;
        MostrarAlerta(resultado.exito, resultado.mensaje);

        if (resultado.exito)
            await CargarTipos();
    }

    private async Task Eliminar()
    {
        guardando = true;
        var resultado = await Api.EliminarAsync("tipo_producto", "id", idEliminar);
        guardando = false;
        mostrarModalEliminar = false;
        MostrarAlerta(resultado.exito, resultado.mensaje);

        if (resultado.exito)
            await CargarTipos();
    }


}
