@page "/aliadoproyecto"
@inject FrontBlazor_AppiGenericaCsharp.Services.AuthService Auth
@inject NavigationManager Nav
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Gestión de Aliado-Proyecto</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
        --indigo: #6366F1;
        --indigo-oscuro: #4F46E5;
        --fondo: #F5F5FF;
        --blanco: #ffffff;
        --texto: #1e1b4b;
        --texto-suave: #6b7280;
        --borde: #e0e0f5;
        --rojo: #e05252;
    }

    .aliadoproyecto-wrapper { font-family: 'DM Sans', sans-serif; background-color: var(--fondo); min-height: 100vh; padding: 2rem; color: var(--texto); }

    .aliadoproyecto-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 2px solid var(--borde); }
    .aliadoproyecto-header h1 { font-family: 'Syne', sans-serif; font-size: 2.2rem; font-weight: 800; color: var(--texto); margin: 0; line-height: 1; }
    .aliadoproyecto-header h1 span { color: var(--indigo); }
    .aliadoproyecto-header p { margin: 0.3rem 0 0; font-size: 0.9rem; color: var(--texto-suave); font-weight: 300; }

    .btn-nuevo { background-color: var(--indigo); color: white; border: none; padding: 0.65rem 1.4rem; border-radius: 10px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: background 0.2s, transform 0.1s; }
    .btn-nuevo:hover { background-color: var(--indigo-oscuro); transform: translateY(-1px); }

    .alerta { padding: 0.9rem 1.2rem; border-radius: 10px; margin-bottom: 1.5rem; font-size: 0.9rem; font-weight: 500; }
    .alerta.exito { background: #e6f9ee; color: #15803d; border: 1px solid #bbf7d0; }
    .alerta.error { background: #fdeaea; color: #b83232; border: 1px solid #f5c0c0; }

    .tabla-card { background: var(--blanco); border-radius: 16px; border: 1px solid var(--borde); overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.04); }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    thead { background-color: var(--texto); color: white; }
    thead th { padding: 1rem 1.2rem; text-align: left; font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase; }
    tbody tr { border-bottom: 1px solid var(--borde); transition: background 0.15s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background-color: #eef2ff; }
    tbody td { padding: 0.9rem 1.2rem; color: var(--texto); vertical-align: middle; }

    .badge { padding: 0.2rem 0.6rem; border-radius: 6px; font-size: 0.82rem; font-weight: 600; display: inline-block; }
    .badge-aliado { background: #e0e7ff; color: var(--indigo-oscuro); }
    .badge-proyecto { background: #dbeafe; color: #1d4ed8; }

    .acciones { display: flex; gap: 0.5rem; }
    .btn-eliminar { background: #fdeaea; color: var(--rojo); border: 1px solid #f5c0c0; padding: 0.35rem 0.8rem; border-radius: 7px; font-size: 0.8rem; font-weight: 500; cursor: pointer; }
    .btn-eliminar:hover { background: #fbd5d5; }

    .sin-datos { text-align: center; padding: 3rem; color: var(--texto-suave); font-size: 0.95rem; }
    .cargando { text-align: center; padding: 3rem; color: var(--texto-suave); }

    /* ── MODAL CORREGIDO ── */
    .modal-overlay { position: fixed !important; inset: 0 !important; background: rgba(0,0,0,0.35) !important; display: flex !important; align-items: center !important; justify-content: center !important; z-index: 9999 !important; }
    .modal { background: var(--blanco) !important; border-radius: 18px !important; padding: 2rem !important; width: 90% !important; max-width: 500px !important; max-height: 90vh !important; overflow-y: auto !important; box-shadow: 0 20px 60px rgba(0,0,0,0.15) !important; animation: slideUp 0.25s ease; display: block !important; visibility: visible !important; z-index: 10000 !important; position: relative !important; }

    @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .modal h2 { font-family: 'Syne', sans-serif !important; font-size: 1.4rem !important; font-weight: 800 !important; margin: 0 0 1.5rem !important; color: var(--texto) !important; display: block !important; }
    .modal h2 span { color: var(--indigo) !important; }

    .campo { margin-bottom: 1.1rem !important; display: block !important; }
    .campo label { display: block !important; font-size: 0.8rem !important; font-weight: 500 !important; color: var(--texto-suave) !important; margin-bottom: 0.4rem !important; text-transform: uppercase !important; letter-spacing: 0.04em !important; }
    .campo select { width: 100% !important; padding: 0.65rem 0.9rem !important; border: 1.5px solid var(--borde) !important; border-radius: 9px !important; font-family: 'DM Sans', sans-serif !important; font-size: 0.9rem !important; color: var(--texto) !important; background: var(--fondo) !important; box-sizing: border-box !important; display: block !important; visibility: visible !important; opacity: 1 !important; height: auto !important; min-height: 40px !important; }
    .campo select:focus { outline: none !important; border-color: var(--indigo) !important; background: white !important; }

    .modal-acciones { display: flex !important; gap: 0.8rem !important; margin-top: 1.5rem !important; justify-content: flex-end !important; }
    .btn-guardar { background: var(--indigo) !important; color: white !important; border: none !important; padding: 0.65rem 1.5rem !important; border-radius: 9px !important; font-family: 'Syne', sans-serif !important; font-weight: 700 !important; font-size: 0.9rem !important; cursor: pointer !important; }
    .btn-guardar:hover { background: var(--indigo-oscuro) !important; }
    .btn-guardar:disabled { opacity: 0.6 !important; cursor: not-allowed !important; }
    .btn-cancelar { background: transparent !important; color: var(--texto-suave) !important; border: 1.5px solid var(--borde) !important; padding: 0.65rem 1.2rem !important; border-radius: 9px !important; font-size: 0.9rem !important; cursor: pointer !important; }
    .btn-cancelar:hover { border-color: var(--texto-suave) !important; }

    .modal-confirmar p { color: var(--texto-suave) !important; font-size: 0.93rem !important; margin: 0.5rem 0 1.5rem !important; display: block !important; }
    .modal-confirmar strong { color: var(--texto) !important; }
    .btn-confirmar-eliminar { background: var(--rojo) !important; color: white !important; border: none !important; padding: 0.65rem 1.5rem !important; border-radius: 9px !important; font-family: 'Syne', sans-serif !important; font-weight: 700 !important; font-size: 0.9rem !important; cursor: pointer !important; }
    .btn-confirmar-eliminar:hover { background: #c94040 !important; }
</style>

<div class="aliadoproyecto-wrapper">

    <div class="aliadoproyecto-header">
        <div>
            <h1>Aliados en <span>Proyectos</span></h1>
            <p>Relación entre aliados y proyectos de investigación</p>
        </div>
        <button class="btn-nuevo" @onclick="AbrirModalNuevo">＋ Nueva Relación</button>
    </div>

    @if (!string.IsNullOrEmpty(mensajeAlerta))
    {
        <div class="alerta @(esExito ? "exito" : "error")">
            @(esExito ? "✓" : "✕") @mensajeAlerta
        </div>
    }

    <div class="tabla-card">
        @if (cargando)
        {
            <div class="cargando">Cargando relaciones...</div>
        }
        else if (registros.Count == 0)
        {
            <div class="sin-datos">No hay relaciones registradas aún.</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Aliado</th>
                        <th>Proyecto</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reg in registros)
                    {
                        <tr>
                            <td><span class="badge badge-aliado">@ObtenerNombreAliado(Valor(reg, "aliado"))</span></td>
                            <td><span class="badge badge-proyecto">@ObtenerNombreProyecto(Valor(reg, "proyecto"))</span></td>
                            <td>
                                <div class="acciones">
                                    <button class="btn-eliminar" @onclick="() => AbrirModalEliminar(reg)">✕ Eliminar</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (mostrarModal)
    {
        <div class="modal-overlay">
            <div class="modal">
                <h2>Nueva <span>Relación</span></h2>

                <div class="campo">
                    <label>Aliado *</label>
                    <select @bind="form_aliado">
                        <option value="">-- Seleccionar aliado --</option>
                        @foreach (var a in listaAliados)
                        {
                            <option value="@Valor(a, "nit")">@Valor(a, "razon_social")</option>
                        }
                    </select>
                </div>

                <div class="campo">
                    <label>Proyecto *</label>
                    <select @bind="form_proyecto">
                        <option value="">-- Seleccionar proyecto --</option>
                        @foreach (var p in listaProyectos)
                        {
                            <option value="@Valor(p, "id")">@Valor(p, "titulo")</option>
                        }
                    </select>
                </div>

                <div class="modal-acciones">
                    <button class="btn-cancelar" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn-guardar" @onclick="Guardar" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Crear")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (mostrarModalEliminar)
    {
        <div class="modal-overlay">
            <div class="modal modal-confirmar">
                <h2>Eliminar <span>Relación</span></h2>
                <p>¿Estás seguro de eliminar la relación entre <strong>@nombreEliminar</strong> y el proyecto?</p>
                <div class="modal-acciones">
                    <button class="btn-cancelar" @onclick="() => mostrarModalEliminar = false">Cancelar</button>
                    <button class="btn-confirmar-eliminar" @onclick="Eliminar" disabled="@guardando">
                        @(guardando ? "Eliminando..." : "Sí, eliminar")
                    </button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> listaAliados = new();
    private List<Dictionary<string, object?>> listaProyectos = new();
    private bool cargando = true;
    private bool mostrarModal = false;
    private bool mostrarModalEliminar = false;
    private bool guardando = false;
    private string mensajeAlerta = "";
    private bool esExito = true;

    private string form_aliado = "";
    private string form_proyecto = "";

    private string aliadoEliminar = "";
    private string nombreEliminar = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.EstaAutenticado)
    {
      Nav.NavigateTo("/login", forceLoad: true);
        return;
    }
        await Task.WhenAll(
            CargarRegistros(),
            CargarListasFK()
        );
    }

    private async Task CargarRegistros()
    {
        cargando = true;
        registros = await Api.ListarAsync("aliado_proyecto");
        cargando = false;
    }

    private async Task CargarListasFK()
    {
        listaAliados   = await Api.ListarAsync("aliado");
        listaProyectos = await Api.ListarAsync("proyecto");
    }

    private string Valor(Dictionary<string, object?> fila, string clave)
        => fila.TryGetValue(clave, out var val) ? val?.ToString() ?? "" : "";

    private string ObtenerNombreAliado(string nit)
    {
        var a = listaAliados.FirstOrDefault(x => Valor(x, "nit") == nit);
        return a != null ? Valor(a, "razon_social") : nit;
    }

    private string ObtenerNombreProyecto(string id)
    {
        var p = listaProyectos.FirstOrDefault(x => Valor(x, "id") == id);
        return p != null ? Valor(p, "titulo") : id;
    }

    private void MostrarAlerta(bool exito, string mensaje)
    {
        esExito = exito;
        mensajeAlerta = mensaje;
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            mensajeAlerta = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private void AbrirModalNuevo()
    {
        form_aliado = "";
        form_proyecto = "";
        mostrarModal = true;
    }

    private void AbrirModalEliminar(Dictionary<string, object?> reg)
    {
        aliadoEliminar = Valor(reg, "aliado");
        nombreEliminar = ObtenerNombreAliado(aliadoEliminar);
        mostrarModalEliminar = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(form_aliado) ||
            string.IsNullOrWhiteSpace(form_proyecto))
        {
            MostrarAlerta(false, "Debe seleccionar un aliado y un proyecto.");
            return;
        }

        guardando = true;

        var datos = new Dictionary<string, object?>
        {
            ["aliado"]   = long.Parse(form_aliado),
            ["proyecto"] = int.Parse(form_proyecto)
        };

        var resultado = await Api.CrearAsync("aliado_proyecto", datos);

        guardando = false;
        mostrarModal = false;
        MostrarAlerta(resultado.exito, resultado.mensaje);

        if (resultado.exito)
            await CargarRegistros();
    }

    private async Task Eliminar()
    {
        guardando = true;
        var resultado = await Api.EliminarAsync("aliado_proyecto", "aliado", aliadoEliminar);
        guardando = false;
        mostrarModalEliminar = false;
        MostrarAlerta(resultado.exito, resultado.mensaje);

        if (resultado.exito)
            await CargarRegistros();
    }
}
