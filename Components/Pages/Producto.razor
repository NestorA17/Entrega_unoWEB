@page "/producto"
@inject FrontBlazor_AppiGenericaCsharp.Services.AuthService Auth
@inject NavigationManager Nav
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Gestión de Productos</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
        --naranja: #F97316;
        --naranja-oscuro: #EA580C;
        --fondo: #FFF8F4;
        --blanco: #ffffff;
        --texto: #2d1a0e;
        --texto-suave: #a37060;
        --borde: #e6d4c8;
        --rojo: #e05252;
    }

    .producto-wrapper { font-family: 'DM Sans', sans-serif; background-color: var(--fondo); min-height: 100vh; padding: 2rem; color: var(--texto); }

    .producto-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 2px solid var(--borde); }
    .producto-header h1 { font-family: 'Syne', sans-serif; font-size: 2.2rem; font-weight: 800; color: var(--texto); margin: 0; line-height: 1; }
    .producto-header h1 span { color: var(--naranja); }
    .producto-header p { margin: 0.3rem 0 0; font-size: 0.9rem; color: var(--texto-suave); font-weight: 300; }

    .btn-nuevo { background-color: var(--naranja); color: white; border: none; padding: 0.65rem 1.4rem; border-radius: 10px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: background 0.2s, transform 0.1s; }
    .btn-nuevo:hover { background-color: var(--naranja-oscuro); transform: translateY(-1px); }

    .alerta { padding: 0.9rem 1.2rem; border-radius: 10px; margin-bottom: 1.5rem; font-size: 0.9rem; font-weight: 500; }
    .alerta.exito { background: #e6f9ee; color: #15803d; border: 1px solid #bbf7d0; }
    .alerta.error { background: #fdeaea; color: #b83232; border: 1px solid #f5c0c0; }

    .tabla-card { background: var(--blanco); border-radius: 16px; border: 1px solid var(--borde); overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.04); }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    thead { background-color: var(--texto); color: white; }
    thead th { padding: 1rem 1.2rem; text-align: left; font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase; }
    tbody tr { border-bottom: 1px solid var(--borde); transition: background 0.15s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background-color: #fff3ed; }
    tbody td { padding: 0.9rem 1.2rem; color: var(--texto); vertical-align: middle; }

    .id-badge { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.82rem; background: #ffedd5; color: var(--naranja-oscuro); padding: 0.2rem 0.6rem; border-radius: 6px; display: inline-block; }
    .categoria-badge { background: #fff7ed; color: var(--naranja-oscuro); border: 1px solid #fed7aa; padding: 0.15rem 0.6rem; border-radius: 20px; font-size: 0.78rem; font-weight: 500; }

    .acciones { display: flex; gap: 0.5rem; }
    .btn-editar { background: #fff8e1; color: #b8860b; border: 1px solid #f5c842; padding: 0.35rem 0.8rem; border-radius: 7px; font-size: 0.8rem; font-weight: 500; cursor: pointer; }
    .btn-editar:hover { background: #fff3c0; }
    .btn-eliminar { background: #fdeaea; color: var(--rojo); border: 1px solid #f5c0c0; padding: 0.35rem 0.8rem; border-radius: 7px; font-size: 0.8rem; font-weight: 500; cursor: pointer; }
    .btn-eliminar:hover { background: #fbd5d5; }

    .sin-datos { text-align: center; padding: 3rem; color: var(--texto-suave); font-size: 0.95rem; }
    .cargando { text-align: center; padding: 3rem; color: var(--texto-suave); }

    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.35); display: flex; align-items: center; justify-content: center; z-index: 1000; }
    .modal { background: var(--blanco) !important; border-radius: 18px !important; padding: 2rem !important; width: 100% !important; max-width: 560px !important; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.15) !important; animation: slideUp 0.25s ease; display: block !important; visibility: visible !important; z-index: 1001 !important; position: relative !important; }

    @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .modal h2 { font-family: 'Syne', sans-serif; font-size: 1.4rem; font-weight: 800; margin: 0 0 1.5rem; color: var(--texto); }
    .modal h2 span { color: var(--naranja); }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
    .campo-full { grid-column: 1 / -1; }

    .campo { margin-bottom: 1.1rem !important; display: block !important; }
    .campo label { display: block !important; font-size: 0.8rem !important; font-weight: 500 !important; color: var(--texto-suave) !important; margin-bottom: 0.4rem !important; text-transform: uppercase !important; letter-spacing: 0.04em !important; }
    .campo input, .campo select { width: 100% !important; padding: 0.65rem 0.9rem !important; border: 1.5px solid var(--borde) !important; border-radius: 9px !important; font-family: 'DM Sans', sans-serif !important; font-size: 0.9rem !important; color: var(--texto) !important; background: var(--fondo) !important; box-sizing: border-box !important; display: block !important; visibility: visible !important; opacity: 1 !important; height: auto !important; min-height: 40px !important; }
    .campo input:focus, .campo select:focus { outline: none !important; border-color: var(--naranja) !important; background: white !important; }
    .campo input:disabled { opacity: 0.6 !important; cursor: not-allowed !important; }

    .modal-acciones { display: flex; gap: 0.8rem; margin-top: 1.5rem; justify-content: flex-end; }
    .btn-guardar { background: var(--naranja); color: white; border: none; padding: 0.65rem 1.5rem; border-radius: 9px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; }
    .btn-guardar:hover { background: var(--naranja-oscuro); }
    .btn-guardar:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-cancelar { background: transparent; color: var(--texto-suave); border: 1.5px solid var(--borde); padding: 0.65rem 1.2rem; border-radius: 9px; font-size: 0.9rem; cursor: pointer; }
    .btn-cancelar:hover { border-color: var(--texto-suave); }

    .modal-confirmar p { color: var(--texto-suave); font-size: 0.93rem; margin: 0.5rem 0 1.5rem; }
    .modal-confirmar strong { color: var(--texto); }
    .btn-confirmar-eliminar { background: var(--rojo); color: white; border: none; padding: 0.65rem 1.5rem; border-radius: 9px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; }
    .btn-confirmar-eliminar:hover { background: #c94040; }
</style>

<div class="producto-wrapper">

    <div class="producto-header">
        <div>
            <h1>Gestión de <span>Productos</span></h1>
            <p>Productos resultantes de los proyectos de investigación</p>
        </div>
        <button class="btn-nuevo" @onclick="AbrirModalNuevo">＋ Nuevo Producto</button>
    </div>

    @if (!string.IsNullOrEmpty(mensajeAlerta))
    {
        <div class="alerta @(esExito ? "exito" : "error")">
            @(esExito ? "✓" : "✕") @mensajeAlerta
        </div>
    }

    <div class="tabla-card">
        @if (cargando)
        {
            <div class="cargando">Cargando productos...</div>
        }
        else if (productos.Count == 0)
        {
            <div class="sin-datos">No hay productos registrados aún.</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Fecha Entrega</th>
                        <th>Proyecto</th>
                        <th>Tipo Producto</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var producto in productos)
                    {
                        <tr>
                            <td><span class="id-badge">@Valor(producto, "id")</span></td>
                            <td>@Valor(producto, "nombre")</td>
                            <td><span class="categoria-badge">@Valor(producto, "categoria")</span></td>
                            <td>@Valor(producto, "fecha_entrega")</td>
                            <td>@ObtenerNombreProyecto(Valor(producto, "proyecto"))</td>
                            <td>@ObtenerNombreTipoProducto(Valor(producto, "tipo_producto"))</td>
                            <td>
                                <div class="acciones">
                                    <button class="btn-editar" @onclick="() => AbrirModalEditar(producto)">✎ Editar</button>
                                    <button class="btn-eliminar" @onclick="() => AbrirModalEliminar(producto)">✕ Eliminar</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (mostrarModal)
    {
        <div class="modal-overlay">
            <div class="modal">
                <h2>@(esEdicion ? "Editar" : "Nuevo") <span>Producto</span></h2>
                <div class="form-grid">

                    <div class="campo campo-full">
                        <label>ID *</label>
                        <input type="number" @bind="form_id" placeholder="Ej: 1" disabled="@esEdicion" />
                    </div>

                    <div class="campo campo-full">
                        <label>Nombre *</label>
                        <input type="text" @bind="form_nombre" placeholder="Nombre del producto" />
                    </div>

                    <div class="campo">
                        <label>Categoría *</label>
                        <input type="text" @bind="form_categoria" placeholder="Ej: Artículo" />
                    </div>

                    <div class="campo">
                        <label>Fecha Entrega *</label>
                        <input type="date" @bind="form_fecha_entrega" @bind:format="yyyy-MM-dd" />
                    </div>

                    <div class="campo campo-full">
                        <label>Proyecto *</label>
                        <select @bind="form_proyecto">
                            <option value="">-- Seleccionar proyecto --</option>
                            @foreach (var p in listaProyectos)
                            {
                                <option value="@Valor(p, "id")">@Valor(p, "titulo")</option>
                            }
                        </select>
                    </div>

                    <div class="campo campo-full">
                        <label>Tipo de Producto *</label>
                        <select @bind="form_tipo_producto">
                            <option value="">-- Seleccionar tipo --</option>
                            @foreach (var t in listaTiposProducto)
                            {
                                <option value="@Valor(t, "id")">@Valor(t, "nombre") (@Valor(t, "categoria"))</option>
                            }
                        </select>
                    </div>

                </div>
                <div class="modal-acciones">
                    <button class="btn-cancelar" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn-guardar" @onclick="Guardar" disabled="@guardando">
                        @(guardando ? "Guardando..." : (esEdicion ? "Actualizar" : "Crear"))
                    </button>
                </div>
            </div>
        </div>
    }

    @if (mostrarModalEliminar)
    {
        <div class="modal-overlay">
            <div class="modal modal-confirmar">
                <h2>Eliminar <span>Producto</span></h2>
                <p>¿Estás seguro de eliminar <strong>@nombreEliminar</strong>? Esta acción no se puede deshacer.</p>
                <div class="modal-acciones">
                    <button class="btn-cancelar" @onclick="() => mostrarModalEliminar = false">Cancelar</button>
                    <button class="btn-confirmar-eliminar" @onclick="Eliminar" disabled="@guardando">
                        @(guardando ? "Eliminando..." : "Sí, eliminar")
                    </button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    // ─── ESTADO ───────────────────────────────────────
    private List<Dictionary<string, object?>> productos = new();
    private List<Dictionary<string, object?>> listaProyectos = new();
    private List<Dictionary<string, object?>> listaTiposProducto = new();
    private bool cargando = true;
    private bool mostrarModal = false;
    private bool mostrarModalEliminar = false;
    private bool esEdicion = false;
    private bool guardando = false;
    private string mensajeAlerta = "";
    private bool esExito = true;

    // ─── CAMPOS DEL FORMULARIO ─────────────────────────
    private string form_id = "";
    private string form_nombre = "";
    private string form_categoria = "";
    private DateTime form_fecha_entrega = DateTime.Today;
    private string form_proyecto = "";
    private string form_tipo_producto = "";

    // ─── PARA ELIMINAR ─────────────────────────────────
    private string idEliminar = "";
    private string nombreEliminar = "";

    // ─── CICLO DE VIDA ─────────────────────────────────
    // ✅ CORRECTO
protected override async Task OnInitializedAsync()
{
    if (!Auth.EstaAutenticado || !Auth.TieneAcceso("/producto"))
    {
        Nav.NavigateTo("/login", forceLoad: true);
        return;
    }
    await Task.WhenAll(
        CargarProductos(),
        CargarListasFK()
    );
}

    private async Task CargarProductos()
    {
        cargando = true;
        productos = await Api.ListarAsync("producto");
        cargando = false;
    }

    // Carga las listas para los selects de FK
    private async Task CargarListasFK()
    {
        listaProyectos     = await Api.ListarAsync("proyecto");
        listaTiposProducto = await Api.ListarAsync("tipo_producto");
    }

    // ─── HELPERS ───────────────────────────────────────
    private string Valor(Dictionary<string, object?> fila, string clave)
        => fila.TryGetValue(clave, out var val) ? val?.ToString() ?? "" : "";

    // Muestra el título del proyecto en la tabla en vez del ID
    private string ObtenerNombreProyecto(string id)
    {
        var p = listaProyectos.FirstOrDefault(x => Valor(x, "id") == id);
        return p != null ? Valor(p, "titulo") : id;
    }

    // Muestra el nombre del tipo de producto en la tabla en vez del ID
    private string ObtenerNombreTipoProducto(string id)
    {
        var t = listaTiposProducto.FirstOrDefault(x => Valor(x, "id") == id);
        return t != null ? Valor(t, "nombre") : id;
    }

    private void MostrarAlerta(bool exito, string mensaje)
    {
        esExito = exito;
        mensajeAlerta = mensaje;
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            mensajeAlerta = "";
            InvokeAsync(StateHasChanged);
        });
    }

    // ─── MODAL NUEVO ───────────────────────────────────
    private void AbrirModalNuevo()
    {
        esEdicion = false;
        form_id = "";
        form_nombre = "";
        form_categoria = "";
        form_fecha_entrega = DateTime.Today;
        form_proyecto = "";
        form_tipo_producto = "";
        mostrarModal = true;
    }

    // ─── MODAL EDITAR ──────────────────────────────────
    private void AbrirModalEditar(Dictionary<string, object?> producto)
    {
        esEdicion = true;
        form_id            = Valor(producto, "id");
        form_nombre        = Valor(producto, "nombre");
        form_categoria     = Valor(producto, "categoria");
        form_fecha_entrega = DateTime.TryParse(Valor(producto, "fecha_entrega"), out var fd) ? fd : DateTime.Today;
        form_proyecto      = Valor(producto, "proyecto");
        form_tipo_producto = Valor(producto, "tipo_producto");
        mostrarModal = true;
    }

    // ─── MODAL ELIMINAR ────────────────────────────────
    private void AbrirModalEliminar(Dictionary<string, object?> producto)
    {
        idEliminar     = Valor(producto, "id");
        nombreEliminar = Valor(producto, "nombre");
        mostrarModalEliminar = true;
    }

    private void CerrarModal() => mostrarModal = false;

    // ─── GUARDAR ───────────────────────────────────────
    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(form_id) ||
            string.IsNullOrWhiteSpace(form_nombre) ||
            string.IsNullOrWhiteSpace(form_categoria) ||
            string.IsNullOrWhiteSpace(form_proyecto) ||
            string.IsNullOrWhiteSpace(form_tipo_producto))
        {
            MostrarAlerta(false, "Todos los campos obligatorios deben estar completos.");
            return;
        }

        guardando = true;

        var datos = new Dictionary<string, object?>
        {
            ["id"]            = int.Parse(form_id),
            ["nombre"]        = form_nombre,
            ["categoria"]     = form_categoria,
            ["fecha_entrega"] = form_fecha_entrega.ToString("yyyy-MM-dd"),
            ["proyecto"]      = int.Parse(form_proyecto),
            ["tipo_producto"] = int.Parse(form_tipo_producto)
        };

        (bool exito, string mensaje) resultado;

        if (esEdicion)
            resultado = await Api.ActualizarAsync("producto", "id", form_id, datos);
        else
            resultado = await Api.CrearAsync("producto", datos);

        guardando = false;
        mostrarModal = false;
        MostrarAlerta(resultado.exito, resultado.mensaje);

        if (resultado.exito)
            await CargarProductos();
    }

    // ─── ELIMINAR ──────────────────────────────────────
    private async Task Eliminar()
    {
        guardando = true;
        var resultado = await Api.EliminarAsync("producto", "id", idEliminar);
        guardando = false;
        mostrarModalEliminar = false;
        MostrarAlerta(resultado.exito, resultado.mensaje);

        if (resultado.exito)
            await CargarProductos();
    }
}

 