@page "/desarrolla"
@inject FrontBlazor_AppiGenericaCsharp.Services.AuthService Auth
@inject NavigationManager Nav
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Gestión de Desarrolla</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
        --teal: #0D9488;
        --teal-oscuro: #0F766E;
        --fondo: #F0FDFA;
        --blanco: #ffffff;
        --texto: #0f2e2b;
        --texto-suave: #5f9ea0;
        --borde: #ccebe8;
        --rojo: #e05252;
    }

    .desarrolla-wrapper { font-family: 'DM Sans', sans-serif; background-color: var(--fondo); min-height: 100vh; padding: 2rem; color: var(--texto); }

    .desarrolla-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 2px solid var(--borde); }
    .desarrolla-header h1 { font-family: 'Syne', sans-serif; font-size: 2.2rem; font-weight: 800; color: var(--texto); margin: 0; line-height: 1; }
    .desarrolla-header h1 span { color: var(--teal); }
    .desarrolla-header p { margin: 0.3rem 0 0; font-size: 0.9rem; color: var(--texto-suave); font-weight: 300; }

    .btn-nuevo { background-color: var(--teal); color: white; border: none; padding: 0.65rem 1.4rem; border-radius: 10px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: background 0.2s, transform 0.1s; }
    .btn-nuevo:hover { background-color: var(--teal-oscuro); transform: translateY(-1px); }

    .alerta { padding: 0.9rem 1.2rem; border-radius: 10px; margin-bottom: 1.5rem; font-size: 0.9rem; font-weight: 500; }
    .alerta.exito { background: #e6f9ee; color: #15803d; border: 1px solid #bbf7d0; }
    .alerta.error { background: #fdeaea; color: #b83232; border: 1px solid #f5c0c0; }

    .tabla-card { background: var(--blanco); border-radius: 16px; border: 1px solid var(--borde); overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.04); }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    thead { background-color: var(--texto); color: white; }
    thead th { padding: 1rem 1.2rem; text-align: left; font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase; }
    tbody tr { border-bottom: 1px solid var(--borde); transition: background 0.15s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background-color: #e6faf8; }
    tbody td { padding: 0.9rem 1.2rem; color: var(--texto); vertical-align: middle; }

    .rol-badge { background: #ccfbf1; color: var(--teal-oscuro); border: 1px solid #99f6e4; padding: 0.15rem 0.6rem; border-radius: 20px; font-size: 0.78rem; font-weight: 500; }

    .acciones { display: flex; gap: 0.5rem; }
    .btn-editar { background: #fff8e1; color: #b8860b; border: 1px solid #f5c842; padding: 0.35rem 0.8rem; border-radius: 7px; font-size: 0.8rem; font-weight: 500; cursor: pointer; }
    .btn-editar:hover { background: #fff3c0; }
    .btn-eliminar { background: #fdeaea; color: var(--rojo); border: 1px solid #f5c0c0; padding: 0.35rem 0.8rem; border-radius: 7px; font-size: 0.8rem; font-weight: 500; cursor: pointer; }
    .btn-eliminar:hover { background: #fbd5d5; }

    .sin-datos { text-align: center; padding: 3rem; color: var(--texto-suave); font-size: 0.95rem; }
    .cargando { text-align: center; padding: 3rem; color: var(--texto-suave); }

    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.35); display: flex; align-items: center; justify-content: center; z-index: 1000; }
    .modal { background: var(--blanco) !important; border-radius: 18px !important; padding: 2rem !important; width: 100% !important; max-width: 560px !important; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.15) !important; animation: slideUp 0.25s ease; display: block !important; visibility: visible !important; z-index: 1001 !important; position: relative !important; }

    @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .modal h2 { font-family: 'Syne', sans-serif; font-size: 1.4rem; font-weight: 800; margin: 0 0 1.5rem; color: var(--texto); }
    .modal h2 span { color: var(--teal); }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
    .campo-full { grid-column: 1 / -1; }

    .campo { margin-bottom: 1.1rem !important; display: block !important; }
    .campo label { display: block !important; font-size: 0.8rem !important; font-weight: 500 !important; color: var(--texto-suave) !important; margin-bottom: 0.4rem !important; text-transform: uppercase !important; letter-spacing: 0.04em !important; }
    .campo input, .campo select, .campo textarea { width: 100% !important; padding: 0.65rem 0.9rem !important; border: 1.5px solid var(--borde) !important; border-radius: 9px !important; font-family: 'DM Sans', sans-serif !important; font-size: 0.9rem !important; color: var(--texto) !important; background: var(--fondo) !important; box-sizing: border-box !important; display: block !important; visibility: visible !important; opacity: 1 !important; height: auto !important; min-height: 40px !important; }
    .campo textarea { resize: vertical; min-height: 80px; }
    .campo input:focus, .campo select:focus, .campo textarea:focus { outline: none !important; border-color: var(--teal) !important; background: white !important; }
    .campo input:disabled, .campo select:disabled { opacity: 0.6 !important; cursor: not-allowed !important; }

    .modal-acciones { display: flex; gap: 0.8rem; margin-top: 1.5rem; justify-content: flex-end; }
    .btn-guardar { background: var(--teal); color: white; border: none; padding: 0.65rem 1.5rem; border-radius: 9px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; }
    .btn-guardar:hover { background: var(--teal-oscuro); }
    .btn-guardar:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-cancelar { background: transparent; color: var(--texto-suave); border: 1.5px solid var(--borde); padding: 0.65rem 1.2rem; border-radius: 9px; font-size: 0.9rem; cursor: pointer; }
    .btn-cancelar:hover { border-color: var(--texto-suave); }

    .modal-confirmar p { color: var(--texto-suave); font-size: 0.93rem; margin: 0.5rem 0 1.5rem; }
    .modal-confirmar strong { color: var(--texto); }
    .btn-confirmar-eliminar { background: var(--rojo); color: white; border: none; padding: 0.65rem 1.5rem; border-radius: 9px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; }
    .btn-confirmar-eliminar:hover { background: #c94040; }
</style>

<div class="desarrolla-wrapper">

    <div class="desarrolla-header">
        <div>
            <h1>Participación en <span>Proyectos</span></h1>
            <p>Docentes que desarrollan proyectos de investigación y su rol</p>
        </div>
        <button class="btn-nuevo" @onclick="AbrirModalNuevo">＋ Nueva Participación</button>
    </div>

    @if (!string.IsNullOrEmpty(mensajeAlerta))
    {
        <div class="alerta @(esExito ? "exito" : "error")">
            @(esExito ? "✓" : "✕") @mensajeAlerta
        </div>
    }

    <div class="tabla-card">
        @if (cargando)
        {
            <div class="cargando">Cargando participaciones...</div>
        }
        else if (registros.Count == 0)
        {
            <div class="sin-datos">No hay participaciones registradas aún.</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Docente</th>
                        <th>Proyecto</th>
                        <th>Rol</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reg in registros)
                    {
                        <tr>
                            <td>@ObtenerNombreDocente(Valor(reg, "docente"))</td>
                            <td>@ObtenerNombreProyecto(Valor(reg, "proyecto"))</td>
                            <td><span class="rol-badge">@Valor(reg, "rol")</span></td>
                            <td>@Valor(reg, "descripcion")</td>
                            <td>
                                <div class="acciones">
                                    <button class="btn-editar" @onclick="() => AbrirModalEditar(reg)">✎ Editar</button>
                                    <button class="btn-eliminar" @onclick="() => AbrirModalEliminar(reg)">✕ Eliminar</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (mostrarModal)
    {
        <div class="modal-overlay">
            <div class="modal">
                <h2>@(esEdicion ? "Editar" : "Nueva") <span>Participación</span></h2>
                <div class="form-grid">

                    <div class="campo campo-full">
                        <label>Docente *</label>
                        <select @bind="form_docente" disabled="@esEdicion">
                            <option value="">-- Seleccionar docente --</option>
                            @foreach (var d in listaDocentes)
                            {
                                <option value="@Valor(d, "cedula")">@Valor(d, "nombres") @Valor(d, "apellidos")</option>
                            }
                        </select>
                    </div>

                    <div class="campo campo-full">
                        <label>Proyecto *</label>
                        <select @bind="form_proyecto" disabled="@esEdicion">
                            <option value="">-- Seleccionar proyecto --</option>
                            @foreach (var p in listaProyectos)
                            {
                                <option value="@Valor(p, "id")">@Valor(p, "titulo")</option>
                            }
                        </select>
                    </div>

                    <div class="campo campo-full">
                        <label>Rol *</label>
                        <select @bind="form_rol">
                            <option value="">-- Seleccionar rol --</option>
                            <option value="Investigador Principal">Investigador Principal</option>
                            <option value="Co-investigador">Co-investigador</option>
                            <option value="Auxiliar">Auxiliar</option>
                            <option value="Asesor">Asesor</option>
                        </select>
                    </div>

                    <div class="campo campo-full">
                        <label>Descripción *</label>
                        <textarea @bind="form_descripcion" placeholder="Descripción del rol en el proyecto"></textarea>
                    </div>

                </div>
                <div class="modal-acciones">
                    <button class="btn-cancelar" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn-guardar" @onclick="Guardar" disabled="@guardando">
                        @(guardando ? "Guardando..." : (esEdicion ? "Actualizar" : "Crear"))
                    </button>
                </div>
            </div>
        </div>
    }

    @if (mostrarModalEliminar)
    {
        <div class="modal-overlay">
            <div class="modal modal-confirmar">
                <h2>Eliminar <span>Participación</span></h2>
                <p>¿Estás seguro de eliminar la participación de <strong>@nombreEliminar</strong>?</p>
                <div class="modal-acciones">
                    <button class="btn-cancelar" @onclick="() => mostrarModalEliminar = false">Cancelar</button>
                    <button class="btn-confirmar-eliminar" @onclick="Eliminar" disabled="@guardando">
                        @(guardando ? "Eliminando..." : "Sí, eliminar")
                    </button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    // ─── ESTADO ───────────────────────────────────────
    private List<Dictionary<string, object?>> registros = new();
    private List<Dictionary<string, object?>> listaDocentes = new();
    private List<Dictionary<string, object?>> listaProyectos = new();
    private bool cargando = true;
    private bool mostrarModal = false;
    private bool mostrarModalEliminar = false;
    private bool esEdicion = false;
    private bool guardando = false;
    private string mensajeAlerta = "";
    private bool esExito = true;

    // ─── CAMPOS DEL FORMULARIO ─────────────────────────
    private string form_docente = "";
    private string form_proyecto = "";
    private string form_rol = "";
    private string form_descripcion = "";

    // ─── PARA ELIMINAR ─────────────────────────────────
    private string docenteEliminar = "";
    private string proyectoEliminar = "";
    private string nombreEliminar = "";

    // ─── CICLO DE VIDA ─────────────────────────────────
    protected override async Task OnInitializedAsync()
{
    if (!Auth.EstaAutenticado || !Auth.TieneAcceso("/desarrolla"))
    {
        Nav.NavigateTo("/login", forceLoad: true);
        return;
    }

    await CargarRegistros();
    await CargarListasFK();
}
    private async Task CargarRegistros()
    {
        cargando = true;
        registros = await Api.ListarAsync("desarrolla");
        cargando = false;
    }

    private async Task CargarListasFK()
    {
        listaDocentes  = await Api.ListarAsync("docente");
        listaProyectos = await Api.ListarAsync("proyecto");
    }

    // ─── HELPERS ───────────────────────────────────────
    private string Valor(Dictionary<string, object?> fila, string clave)
        => fila.TryGetValue(clave, out var val) ? val?.ToString() ?? "" : "";

    private string ObtenerNombreDocente(string cedula)
    {
        var d = listaDocentes.FirstOrDefault(x => Valor(x, "cedula") == cedula);
        return d != null ? $"{Valor(d, "nombres")} {Valor(d, "apellidos")}" : cedula;
    }

    private string ObtenerNombreProyecto(string id)
    {
        var p = listaProyectos.FirstOrDefault(x => Valor(x, "id") == id);
        return p != null ? Valor(p, "titulo") : id;
    }

    private void MostrarAlerta(bool exito, string mensaje)
    {
        esExito = exito;
        mensajeAlerta = mensaje;
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            mensajeAlerta = "";
            InvokeAsync(StateHasChanged);
        });
    }

    // ─── MODALES ───────────────────────────────────────
    private void AbrirModalNuevo()
    {
        esEdicion = false;
        form_docente = "";
        form_proyecto = "";
        form_rol = "";
        form_descripcion = "";
        mostrarModal = true;
    }

    private void AbrirModalEditar(Dictionary<string, object?> reg)
    {
        esEdicion = true;
        form_docente     = Valor(reg, "docente");
        form_proyecto    = Valor(reg, "proyecto");
        form_rol         = Valor(reg, "rol");
        form_descripcion = Valor(reg, "descripcion");
        mostrarModal = true;
    }

    private void AbrirModalEliminar(Dictionary<string, object?> reg)
    {
        docenteEliminar  = Valor(reg, "docente");
        proyectoEliminar = Valor(reg, "proyecto");
        nombreEliminar   = ObtenerNombreDocente(docenteEliminar);
        mostrarModalEliminar = true;
    }

    private void CerrarModal() => mostrarModal = false;

    // ─── GUARDAR ───────────────────────────────────────
    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(form_docente) ||
            string.IsNullOrWhiteSpace(form_proyecto) ||
            string.IsNullOrWhiteSpace(form_rol) ||
            string.IsNullOrWhiteSpace(form_descripcion))
        {
            MostrarAlerta(false, "Todos los campos son obligatorios.");
            return;
        }

        guardando = true;

        var datos = new Dictionary<string, object?>
        {
            ["docente"]      = int.Parse(form_docente),
            ["proyecto"]     = int.Parse(form_proyecto),
            ["rol"]          = form_rol,
            ["descripcion"]  = form_descripcion
        };

        (bool exito, string mensaje) resultado;

        if (esEdicion)
        {
            // La clave compuesta para actualizar es docente
            resultado = await Api.ActualizarAsync("desarrolla", "docente", form_docente, datos);
        }
        else
        {
            resultado = await Api.CrearAsync("desarrolla", datos);
        }

        guardando = false;
        mostrarModal = false;
        MostrarAlerta(resultado.exito, resultado.mensaje);

        if (resultado.exito)
            await CargarRegistros();
    }

    // ─── ELIMINAR ──────────────────────────────────────
    // Esta tabla tiene clave primaria compuesta (docente + proyecto)
    // Eliminamos filtrando por docente primero
    private async Task Eliminar()
    {
        guardando = true;
        var resultado = await Api.EliminarAsync("desarrolla", "docente", docenteEliminar);
        guardando = false;
        mostrarModalEliminar = false;
        MostrarAlerta(resultado.exito, resultado.mensaje);

        if (resultado.exito)
            await CargarRegistros();
    }
}
