@page "/proyecto"
@inject FrontBlazor_AppiGenericaCsharp.Services.AuthService Auth
@inject NavigationManager Nav
@rendermode InteractiveServer
@inject FrontBlazor_AppiGenericaCsharp.Services.ApiService Api

<PageTitle>Gestión de Proyectos</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
        --azul: #3B82F6;
        --azul-oscuro: #2563EB;
        --fondo: #F4F7FA;
        --blanco: #ffffff;
        --texto: #1a2535;
        --texto-suave: #6b7fa3;
        --borde: #d4dde6;
        --rojo: #e05252;
    }

    .proyecto-wrapper { font-family: 'DM Sans', sans-serif; background-color: var(--fondo); min-height: 100vh; padding: 2rem; color: var(--texto); }
    .proyecto-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 2px solid var(--borde); }
    .proyecto-header h1 { font-family: 'Syne', sans-serif; font-size: 2.2rem; font-weight: 800; color: var(--texto); margin: 0; line-height: 1; }
    .proyecto-header h1 span { color: var(--azul); }
    .proyecto-header p { margin: 0.3rem 0 0; font-size: 0.9rem; color: var(--texto-suave); font-weight: 300; }

    .btn-nuevo { background-color: var(--azul); color: white; border: none; padding: 0.65rem 1.4rem; border-radius: 10px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: background 0.2s, transform 0.1s; }
    .btn-nuevo:hover { background-color: var(--azul-oscuro); transform: translateY(-1px); }

    .alerta { padding: 0.9rem 1.2rem; border-radius: 10px; margin-bottom: 1.5rem; font-size: 0.9rem; font-weight: 500; }
    .alerta.exito { background: #e6f9ee; color: #15803d; border: 1px solid #bbf7d0; }
    .alerta.error { background: #fdeaea; color: #b83232; border: 1px solid #f5c0c0; }

    .tabla-card { background: var(--blanco); border-radius: 16px; border: 1px solid var(--borde); overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.04); }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    thead { background-color: var(--texto); color: white; }
    thead th { padding: 1rem 1.2rem; text-align: left; font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase; }
    tbody tr { border-bottom: 1px solid var(--borde); transition: background 0.15s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background-color: #f0f6ff; }
    tbody td { padding: 0.9rem 1.2rem; color: var(--texto); vertical-align: middle; }

    .id-badge { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.82rem; background: #dbeafe; color: var(--azul-oscuro); padding: 0.2rem 0.6rem; border-radius: 6px; display: inline-block; }
    .financiacion-badge { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; padding: 0.15rem 0.6rem; border-radius: 20px; font-size: 0.78rem; font-weight: 500; }
    .titulo-cell { max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 500; }
    .resumen-cell { max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--texto-suave); font-size: 0.83rem; }

    .acciones { display: flex; gap: 0.5rem; }
    .btn-editar { background: #fff8e1; color: #b8860b; border: 1px solid #f5c842; padding: 0.35rem 0.8rem; border-radius: 7px; font-size: 0.8rem; font-weight: 500; cursor: pointer; }
    .btn-editar:hover { background: #fff3c0; }
    .btn-eliminar { background: #fdeaea; color: var(--rojo); border: 1px solid #f5c0c0; padding: 0.35rem 0.8rem; border-radius: 7px; font-size: 0.8rem; font-weight: 500; cursor: pointer; }
    .btn-eliminar:hover { background: #fbd5d5; }

    .sin-datos { text-align: center; padding: 3rem; color: var(--texto-suave); font-size: 0.95rem; }
    .cargando { text-align: center; padding: 3rem; color: var(--texto-suave); }

    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.35); display: flex; align-items: center; justify-content: center; z-index: 1000; }

    .modal { background: var(--blanco) !important; border-radius: 18px !important; padding: 2rem !important; width: 100% !important; max-width: 580px !important; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.15) !important; animation: slideUp 0.25s ease; display: block !important; visibility: visible !important; z-index: 1001 !important; position: relative !important; }

    @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .modal h2 { font-family: 'Syne', sans-serif; font-size: 1.4rem; font-weight: 800; margin: 0 0 1.5rem; color: var(--texto); }
    .modal h2 span { color: var(--azul); }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
    .campo-full { grid-column: 1 / -1; }

    .campo { margin-bottom: 1.1rem !important; display: block !important; }
    .campo label { display: block !important; font-size: 0.8rem !important; font-weight: 500 !important; color: var(--texto-suave) !important; margin-bottom: 0.4rem !important; text-transform: uppercase !important; letter-spacing: 0.04em !important; }
.campo input, .campo select, .campo textarea { width: 100% !important; padding: 0.65rem 0.9rem !important; border: 1.5px solid var(--borde) !important; border-radius: 9px !important; font-family: 'DM Sans', sans-serif !important; font-size: 0.9rem !important; color: var(--texto) !important; background: var(--fondo) !important; box-sizing: border-box !important; display: block !important; visibility: visible !important; opacity: 1 !important; height: auto !important; min-height: 40px !important; }    .campo textarea { resize: vertical; min-height: 80px; }
    .campo input:focus, .campo select:focus, .campo textarea:focus { outline: none !important; border-color: var(--azul) !important; background: white !important; }
    .campo input:disabled { opacity: 0.6 !important; cursor: not-allowed !important; }

    .modal-acciones { display: flex; gap: 0.8rem; margin-top: 1.5rem; justify-content: flex-end; }
    .btn-guardar { background: var(--azul); color: white; border: none; padding: 0.65rem 1.5rem; border-radius: 9px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; }
    .btn-guardar:hover { background: var(--azul-oscuro); }
    .btn-guardar:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-cancelar { background: transparent; color: var(--texto-suave); border: 1.5px solid var(--borde); padding: 0.65rem 1.2rem; border-radius: 9px; font-size: 0.9rem; cursor: pointer; }
    .btn-cancelar:hover { border-color: var(--texto-suave); }

    .modal-confirmar p { color: var(--texto-suave); font-size: 0.93rem; margin: 0.5rem 0 1.5rem; }
    .modal-confirmar strong { color: var(--texto); }
    .btn-confirmar-eliminar { background: var(--rojo); color: white; border: none; padding: 0.65rem 1.5rem; border-radius: 9px; font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9rem; cursor: pointer; }
    .btn-confirmar-eliminar:hover { background: #c94040; }
</style>

<div class="proyecto-wrapper">

    <div class="proyecto-header">
        <div>
            <h1>Gestión de <span>Proyectos</span></h1>
            <p>Proyectos de investigación con su financiación y duración</p>
        </div>
        <button class="btn-nuevo" @onclick="AbrirModalNuevo">＋ Nuevo Proyecto</button>
    </div>

    @if (!string.IsNullOrEmpty(mensajeAlerta))
    {
        <div class="alerta @(esExito ? "exito" : "error")">
            @(esExito ? "✓" : "✕") @mensajeAlerta
        </div>
    }

    <div class="tabla-card">
        @if (cargando)
        {
            <div class="cargando">Cargando proyectos...</div>
        }
        else if (proyectos.Count == 0)
        {
            <div class="sin-datos">No hay proyectos registrados aún.</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>ID</th><th>Título</th><th>Resumen</th><th>Presupuesto</th>
                        <th>Tipo Financiación</th><th>Tipo Fondos</th>
                        <th>Fecha Inicio</th><th>Fecha Fin</th><th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var proyecto in proyectos)
                    {
                        <tr>
                            <td><span class="id-badge">@Valor(proyecto, "id")</span></td>
                            <td><div class="titulo-cell" title="@Valor(proyecto, "titulo")">@Valor(proyecto, "titulo")</div></td>
                            <td><div class="resumen-cell" title="@Valor(proyecto, "resumen")">@Valor(proyecto, "resumen")</div></td>
                            <td>$@Valor(proyecto, "presupuesto")</td>
                            <td><span class="financiacion-badge">@Valor(proyecto, "tipo_financiacion")</span></td>
                            <td>@Valor(proyecto, "tipo_fondos")</td>
                            <td>@Valor(proyecto, "fecha_inicio")</td>
                            <td>@Valor(proyecto, "fecha_fin")</td>
                            <td>
                                <div class="acciones">
                                    <button class="btn-editar" @onclick="() => AbrirModalEditar(proyecto)">✎ Editar</button>
                                    <button class="btn-eliminar" @onclick="() => AbrirModalEliminar(proyecto)">✕ Eliminar</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (mostrarModal)
    {
        <div class="modal-overlay">
            <div class="modal">
                <h2>@(esEdicion ? "Editar" : "Nuevo") <span>Proyecto</span></h2>
                <div class="form-grid">

                    <div class="campo campo-full">
                        <label>ID *</label>
                        <input type="number" @bind="form_id" placeholder="Ej: 1" disabled="@esEdicion" />
                    </div>

                    <div class="campo campo-full">
                        <label>Título *</label>
                        <input type="text" @bind="form_titulo" placeholder="Título del proyecto" />
                    </div>

                    <div class="campo campo-full">
                        <label>Resumen *</label>
                        <textarea @bind="form_resumen" placeholder="Descripción breve del proyecto"></textarea>
                    </div>

                    <div class="campo">
                        <label>Presupuesto *</label>
                        <input type="number" @bind="form_presupuesto" placeholder="Ej: 50000000" step="0.01" />
                    </div>

                    <div class="campo">
                        <label>Tipo Financiación *</label>
                        <select @bind="form_tipo_financiacion">
                            <option value="">-- Seleccionar --</option>
                            <option value="Interno">Interno</option>
                            <option value="Externo">Externo</option>
                            <option value="Mixto">Mixto</option>
                            <option value="Internacional">Internacional</option>
                        </select>
                    </div>

                    <div class="campo">
                        <label>Tipo Fondos *</label>
                        <select @bind="form_tipo_fondos">
                            <option value="">-- Seleccionar --</option>
                            <option value="Publico">Público</option>
                            <option value="Privado">Privado</option>
                            <option value="Mixto">Mixto</option>
                        </select>
                    </div>

                    <div class="campo">
                        <label>Fecha Inicio *</label>
                        <input type="date" @bind="form_fecha_inicio" @bind:format="yyyy-MM-dd" />
                    </div>

                    <div class="campo">
                        <label>Fecha Fin (opcional)</label>
                        <input type="date" @bind="form_fecha_fin" @bind:format="yyyy-MM-dd" />
                    </div>

                </div>
                <div class="modal-acciones">
                    <button class="btn-cancelar" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn-guardar" @onclick="Guardar" disabled="@guardando">
                        @(guardando ? "Guardando..." : (esEdicion ? "Actualizar" : "Crear"))
                    </button>
                </div>
            </div>
        </div>
    }

    @if (mostrarModalEliminar)
    {
        <div class="modal-overlay">
            <div class="modal modal-confirmar">
                <h2>Eliminar <span>Proyecto</span></h2>
                <p>¿Estás seguro de eliminar <strong>@tituloEliminar</strong>? Esta acción no se puede deshacer.</p>
                <div class="modal-acciones">
                    <button class="btn-cancelar" @onclick="() => mostrarModalEliminar = false">Cancelar</button>
                    <button class="btn-confirmar-eliminar" @onclick="Eliminar" disabled="@guardando">
                        @(guardando ? "Eliminando..." : "Sí, eliminar")
                    </button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private List<Dictionary<string, object?>> proyectos = new();
    private bool cargando = true;
    private bool mostrarModal = false;
    private bool mostrarModalEliminar = false;
    private bool esEdicion = false;
    private bool guardando = false;
    private string mensajeAlerta = "";
    private bool esExito = true;

    // Campos del formulario
    private string form_id = "";
    private string form_titulo = "";
    private string form_resumen = "";
    private string form_presupuesto = "";
    private string form_tipo_financiacion = "";
    private string form_tipo_fondos = "";
    private DateTime form_fecha_inicio = DateTime.Today;
    private DateTime? form_fecha_fin = null;

    // Para eliminar
    private string idEliminar = "";
    private string tituloEliminar = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.EstaAutenticado)
    {
       Nav.NavigateTo("/login", forceLoad: true);
        return;
    }
        await CargarProyectos();
    }

    private async Task CargarProyectos()
    {
        cargando = true;
        proyectos = await Api.ListarAsync("proyecto");
        cargando = false;
    }

    private string Valor(Dictionary<string, object?> fila, string clave)
        => fila.TryGetValue(clave, out var val) ? val?.ToString() ?? "" : "";

    private void MostrarAlerta(bool exito, string mensaje)
    {
        esExito = exito;
        mensajeAlerta = mensaje;
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            mensajeAlerta = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private void AbrirModalNuevo()
    {
        esEdicion = false;
        form_id = "";
        form_titulo = "";
        form_resumen = "";
        form_presupuesto = "";
        form_tipo_financiacion = "";
        form_tipo_fondos = "";
        form_fecha_inicio = DateTime.Today;
        form_fecha_fin = null;
        mostrarModal = true;
    }

    private void AbrirModalEditar(Dictionary<string, object?> proyecto)
    {
        esEdicion = true;
        form_id                = Valor(proyecto, "id");
        form_titulo            = Valor(proyecto, "titulo");
        form_resumen           = Valor(proyecto, "resumen");
        form_presupuesto       = Valor(proyecto, "presupuesto");
        form_tipo_financiacion = Valor(proyecto, "tipo_financiacion");
        form_tipo_fondos       = Valor(proyecto, "tipo_fondos");
        form_fecha_inicio      = DateTime.TryParse(Valor(proyecto, "fecha_inicio"), out var fi) ? fi : DateTime.Today;
        form_fecha_fin         = DateTime.TryParse(Valor(proyecto, "fecha_fin"), out var ff) ? ff : null;
        mostrarModal = true;
    }

    private void AbrirModalEliminar(Dictionary<string, object?> proyecto)
    {
        idEliminar     = Valor(proyecto, "id");
        tituloEliminar = Valor(proyecto, "titulo");
        mostrarModalEliminar = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(form_id) ||
            string.IsNullOrWhiteSpace(form_titulo) ||
            string.IsNullOrWhiteSpace(form_resumen) ||
            string.IsNullOrWhiteSpace(form_presupuesto) ||
            string.IsNullOrWhiteSpace(form_tipo_financiacion) ||
            string.IsNullOrWhiteSpace(form_tipo_fondos))
        {
            MostrarAlerta(false, "Todos los campos obligatorios deben estar completos.");
            return;
        }

        guardando = true;

        var datos = new Dictionary<string, object?>
        {
            ["id"]                = int.Parse(form_id),
            ["titulo"]            = form_titulo,
            ["resumen"]           = form_resumen,
            ["presupuesto"]       = double.Parse(form_presupuesto),
            ["tipo_financiacion"] = form_tipo_financiacion,
            ["tipo_fondos"]       = form_tipo_fondos,
            ["fecha_inicio"]      = form_fecha_inicio.ToString("yyyy-MM-dd"),
            ["fecha_fin"]         = form_fecha_fin.HasValue ? form_fecha_fin.Value.ToString("yyyy-MM-dd") : null
        };

        (bool exito, string mensaje) resultado;

        if (esEdicion)
            resultado = await Api.ActualizarAsync("proyecto", "id", form_id, datos);
        else
            resultado = await Api.CrearAsync("proyecto", datos);

        guardando = false;
        mostrarModal = false;
        MostrarAlerta(resultado.exito, resultado.mensaje);

        if (resultado.exito)
            await CargarProyectos();
    }

    private async Task Eliminar()
    {
        guardando = true;
        var resultado = await Api.EliminarAsync("proyecto", "id", idEliminar);
        guardando = false;
        mostrarModalEliminar = false;
        MostrarAlerta(resultado.exito, resultado.mensaje);

        if (resultado.exito)
            await CargarProyectos();
    }
}
